# Download tokens (CPU prefetch). Do not commit real values.
HF_TOKEN=
CIVITAI_TOKEN=
GITHUB_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Local data root (SQLite + generated images).
MODAL_SANA_DATA_DIR=data

# Web UI
MODAL_SANA_HOST=127.0.0.1
MODAL_SANA_PORT=7860

# Defaults
MODAL_SANA_DEFAULT_MODEL=sana-sprint-1.6b
MODAL_SANA_DEFAULT_GPU=L40S

# Set to 1 to call a previously deployed Modal app instead of an ephemeral run.
MODAL_SANA_DEPLOYED=0
MODAL_SANA_APP_NAME=modal-sana

# Local HTTP CONNECT / SOCKS proxy for the Modal client.
# Requires the modal[api-proxy-support] extra (python-socks + aiohttp-socks).
# Modal reads the standard env vars — there is no separate MODAL_HTTP_PROXY.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:1080
# NO_PROXY=localhost,127.0.0.1
# MODAL_DISABLE_API_PROXY=0
